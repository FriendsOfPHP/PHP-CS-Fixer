--TEST--
Integration of fixers: phpdoc_nullable_type,phpdoc_align.
--RULESET--
{"phpdoc_nullable_type": true, "phpdoc_align": true}
--EXPECT--
<?php
/**
 * @param ?Foo $fo  fo descr
 * @param Bar  $bar fo descr
 */
function foo ($fo, $bar) {}

--INPUT--
<?php
/**
 * @param null|Foo $fo fo descr
 * @param Bar $bar fo descr
 */
function foo ($fo, $bar) {}
