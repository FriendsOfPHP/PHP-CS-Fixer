--TEST--
Integration of fixers: long_to_shorthand_operator_for_complex_targets,binary_operator_spaces.
--RULESET--
{"long_to_shorthand_operator_for_complex_targets": true, "binary_operator_spaces": {"operators":{"+":"align_single_space"}}}
--EXPECT--
<?php

$a[0] += 2;
$ab[1] = 3 + 1;

--INPUT--
<?php

$a[0] = $a[0]   +    2;
$ab[1]              = 3 + 1;
