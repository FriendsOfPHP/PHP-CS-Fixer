--TEST--
Integration of fixers: method_argument_space,braces.
--RULESET--
{"method_argument_space": {"on_multiline": "ensure_fully_multiline"}, "braces": true}
--EXPECT--
<?php
function test(
    string $a,
    string $b
): void {
    $a = $b;
}

--INPUT--
<?php
function test(
    string $a,string $b): void
{
    $a = $b;
}
